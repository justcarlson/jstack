Survive hung gh calls and flaky required-check reads in pr-wait
(from https://github.com/t3dotgg/tstack/pull/24, Linux/macOS commits only;
omits the Windows msvcrt lock commit).

diff --git a/skills/babysit-pr/scripts/pr-wait b/skills/babysit-pr/scripts/pr-wait
--- a/skills/babysit-pr/scripts/pr-wait
+++ b/skills/babysit-pr/scripts/pr-wait
@@ -68,6 +68,8 @@
 # instead of replaying hours of comments as new events.
 STALE_STATE_SECONDS = 6 * 3600
 MAX_FAILED_POLLS = 10
+# A hung gh call would block the watcher silently and keep holding the lock.
+GH_TIMEOUT_SECONDS = 120
 TRANSIENT = re.compile(
     r"HTTP (5\d\d|429)|rate limit|timed? ?out|connection (reset|refused)|EOF|"
     r"temporar|could not resolve host|TLS handshake|Something went wrong",
@@ -124,7 +126,11 @@
     """Run gh. Retries transient failures (HTTP 5xx or 429, network) with backoff."""
     delay = 2
     for attempt in range(5):
-        proc = subprocess.run(["gh", *args], capture_output=True, text=True)
+        try:
+            proc = subprocess.run(["gh", *args], capture_output=True, text=True, timeout=GH_TIMEOUT_SECONDS)
+        except subprocess.TimeoutExpired:
+            # Matches TRANSIENT, so it retries with backoff like a network error.
+            proc = subprocess.CompletedProcess(["gh", *args], 124, "", f"gh timed out after {GH_TIMEOUT_SECONDS}s")
         transient = proc.returncode != 0 and bool(TRANSIENT.search(proc.stderr))
         if not transient and proc.returncode in allow:
             return proc
@@ -240,6 +246,12 @@
         try:
             names.update(gh_lines(["api", path, "--jq", jq]))
         except GhError as error:
+            # The set is read once and cached, so a transient failure here would
+            # leave a partial set that turns green early. Re-raise so the poll
+            # retries with self.required still unset. Permission errors (a
+            # non-admin reading branch protection) still skip.
+            if error.transient:
+                raise
             if "HTTP 404" not in str(error):  # 404 means no protection, which is normal
                 log(f"could not read required checks from {path}: {error}")
     return names
